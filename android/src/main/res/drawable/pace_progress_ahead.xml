<?xml version="1.0" encoding="utf-8"?>
<!-- Ahead of pace: progress = % of the period elapsed (blue), secondaryProgress = % used.
     The amber strip past the blue is quota spent ahead of the steady pace. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="#14263F" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/ahead" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/used" />
            </shape>
        </clip>
    </item>
</layer-list>
