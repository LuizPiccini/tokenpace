<?xml version="1.0" encoding="utf-8"?>
<!-- progress = % used, secondaryProgress = % of the period elapsed; the teal strip past the
     used bar is the slack that would be lost at the reset. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="#14263F" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/elapsed" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/used" />
            </shape>
        </clip>
    </item>
</layer-list>
