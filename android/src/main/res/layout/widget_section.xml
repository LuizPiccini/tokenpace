<?xml version="1.0" encoding="utf-8"?>
<!-- Group header: the group's logo (if the server has one in PNG/JPEG/WebP) and its label.
     UsageWidget.SECTION_PADDING and SECTION_LOGO mirror this layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp">

    <ImageView
        android:id="@+id/section_logo"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/section_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/ink_muted"
        android:textSize="10sp" />
</LinearLayout>
